# Copy this file to .env.local before building:  cp .env.example .env.local
#
# Every NEXT_PUBLIC_ value is inlined into the browser bundle AT BUILD TIME: after changing one,
# run `npm run build` again. Never put a secret or a URL carrying an API key in a NEXT_PUBLIC_ name.

# ── Needed for a local run ───────────────────────────────────────────────────
# The IntentFolio vault contract on NEAR mainnet. The dashboard lists portfolios from it; left
# empty, the portfolio list never loads.
NEXT_PUBLIC_VAULT_CONTRACT_ID=intentfolio-vault.near

# ── Optional: wallet connections ─────────────────────────────────────────────
# Reown (WalletConnect) project id, for EVM wallets through WalletConnect (mobile QR). Browser
# extension wallets such as MetaMask work without it. Get one at https://cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Leave empty: the app serves its own TonConnect manifest at /tonconnect-manifest.json.
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=

# ── Optional: RPC endpoints (empty => public defaults) ───────────────────────
# Server-side NEAR RPC used by /api/near-rpc. Empty => FastNEAR's free endpoint.
NEAR_RPC_API_KEY=
NEAR_RPC_PRIMARY_URL=
# NEAR RPC handed to the wallets. Empty => https://free.rpc.fastnear.com
NEXT_PUBLIC_NEAR_RPC_URL=
# Other chains, read to show wallet holdings and to price withdrawals. Empty => public endpoints.
NEXT_PUBLIC_EVM_RPC_ETHEREUM=
NEXT_PUBLIC_EVM_RPC_ARBITRUM=
NEXT_PUBLIC_EVM_RPC_BASE=
NEXT_PUBLIC_EVM_RPC_BSC=
NEXT_PUBLIC_EVM_RPC_POLYGON=
NEXT_PUBLIC_EVM_RPC_AVALANCHE=
NEXT_PUBLIC_EVM_RPC_OPTIMISM=
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_ONECLICK_BASE_URL=

# ── Real-funds paths: OFF by default ─────────────────────────────────────────
# These switch the app from its in-memory paths to signing real transactions on NEAR mainnet.
# The hosted app (https://intentfolio.app) runs with them on. A local run does not need them.
NEXT_PUBLIC_VAULT_ROUNDTRIP=
NEXT_PUBLIC_VAULT_RELAY=
NEXT_PUBLIC_REAL_WITHDRAWAL=
NEXT_PUBLIC_UNIVERSAL_WITHDRAWAL=
NEXT_PUBLIC_WALLET_DEPOSIT=
NEXT_PUBLIC_OPS_RECORDS=
NEXT_PUBLIC_WITHDRAW_RECORDS=

# ── Server only: gas relayer and databases (not needed locally) ──────────────
# The relayer account pays gas for envelopes users sign, through FunctionCall keys limited to one
# receiver and one method each. Never give any of these a NEXT_PUBLIC_ prefix.
RELAYER_ACCOUNT_ID=
RELAYER_VERIFIER_PRIVATE_KEY=
RELAYER_VAULT_PRIVATE_KEY=
RELAY_PAUSED=
RELAYER_MAX_REQUESTS=
RELAYER_MAX_NEAR_SPEND=
# Postgres: the operations records and the value-history database behind the Performance and
# Evolution charts. Without them those charts show no history; the rest of the app still works.
INTENTFOLIO_OPS_DB_URL=
INTENTFOLIO_OPS_DB_SSL=
INTENTFOLIO_HISTORY_READER_DB_URL=
INTENTFOLIO_HISTORY_WRITER_DB_URL=
# Optional alert channel for a broken operations write path.
INTENTFOLIO_OPS_ALERT_TELEGRAM_BOT_TOKEN=
INTENTFOLIO_OPS_ALERT_TELEGRAM_CHAT_ID=
